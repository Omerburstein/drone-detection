# Datasets and weights are large and/or license-restricted -- never commit them.
# Leading slashes anchor these to the repo root: an unanchored `data/` also
# matches source directories like `src/data/`, which silently drops code.
# Keep the slashes -- `src/data/` is a tracked package, not a dataset.
/data/
/weights/
/runs/
# ...but keep the dataset metadata. MANIFEST/data.yaml/conditions record how a
# split was built and where it came from; that provenance is worthless if it
# only exists on the machine that happened to run the conversion. Images and
# labels stay ignored.
!/data/
/data/*
!/data/processed/
/data/processed/*
!/data/processed/*/
/data/processed/*/*
!/data/processed/*/MANIFEST.md
!/data/processed/*/data.yaml
!/data/processed/*/conditions.json
# ...and keep the metrics, which are small and are what the ledger cites.
!/runs/
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/metrics.json
*.pt
*.onnx
*.engine
*.xml
*.bin

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Cloned upstream repos (GLAD, yolov5) -- large, not ours to version.
/third_party/
