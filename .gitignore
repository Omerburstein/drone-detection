# Datasets and weights are large and/or license-restricted -- never commit them.
# Leading slashes anchor these to the repo root: an unanchored `data/` also
# matches source directories like `src/data/`, which silently drops code.
# Keep the slashes -- `src/data/` is a tracked package, not a dataset.
/data/
/weights/
/runs/
# ...but keep the metrics, which are small and are what the ledger cites.
!/runs/
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/metrics.json
*.pt
*.onnx
*.engine
*.xml
*.bin

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
